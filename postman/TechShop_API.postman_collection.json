{
  "info": {
    "name": "TechShop - API de registro e inicio de sesión",
    "description": "Colección de pruebas de la evidencia GA7-220501096-AA5-EV02. Ejecutar en orden (Collection Runner) con el servicio iniciado con npm start. La variable base_url apunta por defecto a http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Estado del servicio",
      "item": [
        {
          "name": "PM-01 Salud del servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código de estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mensaje: Servicio activo', () => pm.expect(pm.response.json().mensaje).to.eql('Servicio activo'));",
                  "pm.test('exito es true', () => pm.expect(pm.response.json().exito).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/salud",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "salud"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Registro (POST /api/registro)",
      "item": [
        {
          "name": "PM-02 Registro exitoso",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufijo = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('usuario_prueba', 'user' + sufijo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código de estado 201', () => pm.response.to.have.status(201));",
                  "pm.test('Mensaje: Usuario registrado correctamente', () => pm.expect(pm.response.json().mensaje).to.eql('Usuario registrado correctamente'));",
                  "pm.test('No devuelve la contraseña ni el hash', () => {",
                  "  const texto = pm.response.text();",
                  "  pm.expect(texto).to.not.include('Clave1234');",
                  "  pm.expect(texto).to.not.include('$2');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/registro",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuario_prueba}}\",\n  \"contrasena\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
